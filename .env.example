# ------------------------------------------------------------
# ŞABLON dosya — repoya gönderilir, gerçek değer içermez.
# Kurulum:  cp .env.example .env   ve değerleri doldurun.
# ------------------------------------------------------------

# Testlerin koşacağı ortam (dev / staging / prod)
BASE_URL=https://www.saucedemo.com

# Geçerli kullanıcıların parolası (gizli bilgi -> boş bırakıldı)
USER_PASSWORD=

# Tarayıcı davranışı
HEADLESS=true
SLOW_MO=0

# Süre limitleri (ms)
ACTION_TIMEOUT=15000
TEST_TIMEOUT=60000

# Başarısız testin tekrar deneme sayısı
RETRIES=0
