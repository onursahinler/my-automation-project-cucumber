{
  "name": "my-automation-project-cucumber",
  "version": "1.0.0",
  "description": "SauceDemo UI otomasyon projesi - Cucumber (BDD) + Playwright + TypeScript + Page Object Model",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "test": "cucumber-js",
    "test:smoke": "cucumber-js --profile smoke",
    "test:regression": "cucumber-js --profile regression",
    "test:login": "cucumber-js features/login.feature",
    "test:e2e": "cucumber-js --tags @e2e",
    "test:headed": "cross-env HEADLESS=false cucumber-js",
    "test:ci": "cucumber-js --profile ci",
    "test:rerun": "cucumber-js @rerun.txt",
    "install:browsers": "playwright install --with-deps chromium",
    "clean": "rm -rf allure-results allure-report cucumber-report test-results rerun.txt",
    "pretest": "npm run clean",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "report:allure": "npm run allure:generate && npm run allure:open"
  },
  "keywords": [
    "cucumber",
    "bdd",
    "gherkin",
    "playwright",
    "typescript",
    "page-object-model",
    "test-automation"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@faker-js/faker": "^10.0.0",
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.7.0",
    "allure-commandline": "^2.43.0",
    "allure-cucumberjs": "^3.12.1",
    "allure-js-commons": "^3.12.1",
    "cross-env": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
